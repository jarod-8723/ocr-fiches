%% fiche.sty - style des fiches de revision (projet OCR Fiche)
%% Le STYLE (couleurs, police, cadres) vit ici. Les fichiers .tex ne
%% contiennent que le CONTENU : on peut changer toute la DA sans
%% retoucher une seule transcription.
%% Compiler avec XeLaTeX (police perso). pdfLaTeX marche aussi (police par defaut).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fiche}[2026/11/20 v0.1 Fiches de revision]

% ---------- Moteur, police, langue ----------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}
  \renewcommand{\familydefault}{\sfdefault}
\else
  \RequirePackage[no-math]{fontspec}
  % Police provisoire (Shantell Sans, licence OFL) tant que la tienne n'existe pas
  \IfFileExists{polices/ShantellSans-Regular.ttf}{%
    \setmainfont{ShantellSans}[Path=polices/, Extension=.ttf,
      UprightFont=*-Regular, BoldFont=*-Bold,
      ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic]}{%
    \setmainfont{Latin Modern Sans}}
\fi
% \policeperso{MaPolice.ttf} : ta police manuscrite (fichier dans polices/)
\newcommand{\policeperso}[1]{%
  \ifPDFTeX\PackageWarning{fiche}{\string\policeperso\space demande XeLaTeX}%
  \else\setmainfont{#1}[Path=polices/, AutoFakeBold=2.5, AutoFakeSlant=0.18]\fi}

\RequirePackage[french]{babel}
\RequirePackage[none]{hyphenat}            % pas de cesure
\AtBeginDocument{\hyphenpenalty=10000 \exhyphenpenalty=10000 \raggedright}

% ---------- Mise en page ----------
\RequirePackage[a4paper, top=1.6cm, bottom=1.7cm, left=1.8cm, right=1.8cm,
  headheight=16pt, headsep=8pt, footskip=18pt, includehead, includefoot]{geometry}
\RequirePackage{amsmath, amssymb, mathtools}
\RequirePackage{xcolor, pifont, etoolbox, enumitem, fancyhdr}
\RequirePackage[normalem]{ulem}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{decorations.pathmorphing, babel}
\RequirePackage[most]{tcolorbox}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}
\setlength{\emergencystretch}{3em}

% ---------- Palette (DA tableau blanc) ----------
\definecolor{fiche@rose}{HTML}{FF4F9A}
\definecolor{fiche@roseclair}{HTML}{FFB3D6}
\definecolor{fiche@rosepale}{HTML}{FFEEF6}
\definecolor{fiche@encre}{HTML}{2B2440}
\definecolor{fiche@gris}{HTML}{8A8499}
\definecolor{fiche@jaune}{HTML}{FFC93C}
\AtBeginDocument{\color{fiche@encre}}

\newcommand{\fiche@etoile}{\ding{72}}      % etoile pleine
\newcommand{\fiche@etoilevide}{\ding{73}}  % etoile vide

% Trait "feutre" legerement tremble (fixe : meme rendu a chaque compilation)
\pgfmathsetseed{42}
\tikzset{fiche@trait/.style={decorate, line join=round, line cap=round,
  decoration={random steps, segment length=5pt, amplitude=0.5pt}}}

% ---------- Metadonnees (preambule, hors transcription) ----------
\newcommand{\fiche@matiere}{}\newcommand{\fiche@chapitre}{}\newcommand{\fiche@source}{}
\newcommand{\matiere}[1]{\renewcommand{\fiche@matiere}{#1}}
\newcommand{\chapitre}[1]{\renewcommand{\fiche@chapitre}{#1}}
\newcommand{\source}[1]{\edef\fiche@source{\detokenize{#1}}} % _ autorises

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\small\color{fiche@gris}\fiche@matiere
  \ifdefempty{\fiche@chapitre}{}{\ \textcolor{fiche@rose}{\fiche@etoile}\ \fiche@chapitre}}
\fancyhead[R]{\small\textcolor{fiche@roseclair}{\fiche@etoilevide}%
  \,\textcolor{fiche@rose}{\fiche@etoile}\ \color{fiche@gris}\thepage}
\fancyfoot[L]{\ifdefempty{\fiche@source}{}{\scriptsize\color{fiche@gris}scan : \texttt{\fiche@source}}}

% ---------- Titres ----------
\newcommand{\titre}[1]{%
  \par{\centering\begin{tikzpicture}
    \node[align=center, text width=0.84\linewidth, font=\huge\bfseries,
          text=fiche@encre] (T) {#1};
    \draw[fiche@trait, line width=3pt, fiche@rose, opacity=.85]
      ([yshift=-5pt]T.south west) -- ([yshift=-5pt]T.south east);
    \node[text=fiche@rose, font=\LARGE] at ([xshift=-6pt]T.west) {\fiche@etoile};
    \node[text=fiche@jaune, font=\large] at ([xshift=-14pt,yshift=12pt]T.west) {\fiche@etoile};
    \node[text=fiche@rose, font=\LARGE] at ([xshift=6pt]T.east) {\fiche@etoilevide};
  \end{tikzpicture}\par}\vspace{2pt}}

\setcounter{secnumdepth}{0}   % numerotation : on recopie celle de la fiche
\renewcommand{\section}{\@startsection{section}{1}{0pt}{1.8ex plus .4ex}{.6ex}%
  {\normalfont\Large\bfseries\color{fiche@rose}\fiche@etoile\ \color{fiche@encre}}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{0pt}{1.6ex plus .4ex}{.5ex}%
  {\normalfont\large\bfseries\color{fiche@rose}\fiche@etoilevide\ \color{fiche@encre}}}

% ---------- Listes ----------
\setlist{itemsep=1pt, topsep=2pt}
\setlist[itemize,1]{label=\textcolor{fiche@rose}{\fiche@etoile}}
\setlist[itemize,2]{label=\textcolor{fiche@rose}{\fiche@etoilevide}}
\setlist[itemize,3]{label=\textcolor{fiche@gris}{\textbullet}}

% ---------- Marques a la main ----------
\newcommand{\souligne}[1]{\bgroup\markoverwith{\textcolor{fiche@rose}%
  {\rule[-0.55ex]{2pt}{1.1pt}}}\ULon{#1}}
\newcommand{\surligne}[1]{{\setlength{\fboxsep}{1.5pt}\colorbox{fiche@roseclair}{\strut #1}}}
\newtcbox{\entoure}{enhanced, on line, colback=white, boxrule=0pt, frame hidden,
  boxsep=1pt, left=3pt, right=3pt, top=2pt, bottom=2pt,
  overlay={\draw[fiche@trait, line width=1.2pt, fiche@rose]
    (frame.south west) rectangle (frame.north east);}}
\newcommand{\couleur}[2]{\textcolor{fiche@c@#1}{#2}}
\definecolor{fiche@c@rouge}{HTML}{E5383B}  \definecolor{fiche@c@bleu}{HTML}{3D6DE0}
\definecolor{fiche@c@vert}{HTML}{2FA37A}   \definecolor{fiche@c@rose}{HTML}{FF4F9A}
\definecolor{fiche@c@violet}{HTML}{7B5CD6} \definecolor{fiche@c@orange}{HTML}{F08A24}
\definecolor{fiche@c@noir}{HTML}{2B2440}
\newcommand{\illisible}[1]{\ifstrempty{#1}%
  {\textcolor{fiche@rose}{[?]}}{\textcolor{fiche@rose}{#1\textsuperscript{?}}}}
\newcommand{\marge}[1]{\par{\raggedleft\small\itshape\color{fiche@gris}\ding{46}~#1\par}}

% ---------- Blocs ----------
\tcbset{
  fiche@base/.style={enhanced, breakable, colback=white, boxrule=0pt,
    frame hidden, arc=0pt, left=8pt, right=8pt, top=6pt, bottom=5pt,
    before skip=6pt, after skip=4pt, before upper=\raggedright},
  % #1 etiquette, #2 titre optionnel, #3 couleur du trait, #4 fond
  fiche@boite/.style n args={4}{fiche@base, enlarge top by=5pt, top=11pt,
    interior code={\fill[#4] (interior.south west) rectangle (interior.north east);},
    frame code={\draw[fiche@trait, line width=1.2pt, #3]
      (frame.south west) rectangle (frame.north east);},
    overlay unbroken and first={\node[anchor=west, rotate=2, fill=#3,
      text=white, font=\small\bfseries, inner xsep=6pt, inner ysep=3pt]
      at ([xshift=10pt]frame.north west)
      {\fiche@etoile\ #1\ifstrempty{#2}{}{ : #2}};}},
}
\newtcolorbox{definition}[1][]{fiche@boite={Déf}{#1}{fiche@rose}{fiche@rosepale}}
\newtcolorbox{theoreme}[1][]{fiche@boite={Théorème}{#1}{fiche@encre}{fiche@rosepale},
  frame code={\draw[fiche@trait, line width=1.6pt, fiche@encre]
    (frame.south west) rectangle (frame.north east);
    \draw[fiche@trait, line width=.8pt, fiche@rose]
    ([xshift=2.5pt,yshift=2.5pt]frame.south west) rectangle ([xshift=-2.5pt,yshift=-2.5pt]frame.north east);}}
\newtcolorbox{propriete}[1][]{fiche@boite={Propriété}{#1}{fiche@rose}{white}}
\newtcolorbox{methode}[1][]{fiche@boite={Méthode}{#1}{fiche@encre}{white},
  frame code={\draw[fiche@trait, line width=1pt, fiche@encre, dash pattern=on 5pt off 3pt]
    (frame.south west) rectangle (frame.north east);}}
\newtcolorbox{attention}[1][]{fiche@boite={Attention}{#1}{fiche@c@rouge}{fiche@rosepale},
  frame code={\draw[fiche@trait, line width=2pt, fiche@c@rouge]
    (frame.south west) rectangle (frame.north east);}}
\newtcolorbox{exemple}[1][]{fiche@base, enlarge top by=5pt, top=11pt,
  frame code={\draw[fiche@trait, line width=2.5pt, fiche@roseclair]
    (frame.south west) -- (frame.north west);},
  overlay unbroken and first={\node[anchor=west, font=\small\bfseries,
    text=fiche@rose] at ([xshift=6pt,yshift=-5pt]frame.north west)
    {\fiche@etoilevide\ Ex\ifstrempty{#1}{}{ : #1}};}}
\newtcolorbox{remarque}[1][]{fiche@base, fontupper=\small, left=6pt,
  frame code={\draw[fiche@trait, line width=1pt, fiche@gris]
    (frame.south west) -- (frame.north west);},
  before upper={\raggedright\textbf{\textcolor{fiche@gris}{Rq\ifstrempty{#1}{}{ (#1)} :}}\ }}
\newtcolorbox{demo}[1][]{fiche@base, fontupper=\small, left=6pt,
  frame code={\draw[fiche@trait, line width=1pt, fiche@gris, dash pattern=on 2pt off 2pt]
    (frame.south west) -- (frame.north west);},
  before upper={\raggedright\textit{\textcolor{fiche@gris}{Démo\ifstrempty{#1}{}{ (#1)} :}}\ },
  after upper={\hfill\textcolor{fiche@rose}{\fiche@etoilevide}}}
\newtcolorbox{encadre}{fiche@base, frame code={\draw[fiche@trait, line width=1.2pt,
  fiche@rose] (frame.south west) rectangle (frame.north east);}}
% \dessin[x1,y1,x2,y2]{description} : sans le serveur (zone non découpée), boîte « Dessin : ... »
\newcommand{\dessin}[2][]{%
  \begin{tcolorbox}[fiche@base, unbreakable, colback=fiche@rosepale, halign=center, valign=center,
    height=1.35cm, frame code={\draw[fiche@trait, line width=1pt, fiche@roseclair,
    dash pattern=on 4pt off 3pt] (frame.south west) rectangle (frame.north east);}]
  {\color{fiche@gris}\ding{46}\ \textit{Dessin : #2}}
  \end{tcolorbox}}
% \dessinimg{gauche}{largeur}{image} : dessin découpé dans le scan, même taille et même place
% horizontale que sur la feuille (gauche et largeur en fraction de la largeur de la page)
\newlength\fiche@dx \newlength\fiche@dw
\newcommand{\dessinimg}[3]{%
  \par\smallskip\noindent
  \setlength\fiche@dw{#2\paperwidth}%
  \ifdim\fiche@dw>\linewidth\setlength\fiche@dw{\linewidth}\fi
  \setlength\fiche@dx{\dimexpr #1\paperwidth-1in-\oddsidemargin-\hoffset-\@totalleftmargin\relax}%
  \ifdim\fiche@dx<\z@\setlength\fiche@dx{\z@}\fi
  \ifdim\dimexpr\fiche@dx+\fiche@dw\relax>\linewidth\setlength\fiche@dx{\dimexpr\linewidth-\fiche@dw\relax}\fi
  \hspace*{\fiche@dx}\includegraphics[width=\fiche@dw,height=.8\textheight,keepaspectratio]{#3}%
  \par\smallskip}
% acote : dessin et texte côte à côte, comme sur la feuille.
% \begin{acote}[x1,y1,x2,y2]{description} texte \end{acote} ; le serveur le remplace par acoteimg.
\NewDocumentEnvironment{acote}{o m}{\par\dessin{#2}\par}{\par}
\newlength\fiche@dt
\NewDocumentEnvironment{acoteimg}{m m m}{% #1 = g (dessin à gauche) ou d, #2 = largeur (fraction de page), #3 = image
  \par\smallskip\noindent
  \setlength\fiche@dw{#2\paperwidth}%
  \ifdim\fiche@dw>.62\linewidth\setlength\fiche@dw{.62\linewidth}\fi
  \setlength\fiche@dt{\dimexpr\linewidth-\fiche@dw-1.2em\relax}%
  \if g#1\begin{minipage}[t]{\fiche@dw}\vspace{0pt}\includegraphics[width=\linewidth,height=.6\textheight,keepaspectratio]{#3}\end{minipage}\hfill\fi
  \begin{minipage}[t]{\fiche@dt}\vspace{0pt}\raggedright\setlength\parskip{3pt}}
 {\end{minipage}%
  \if d#1\hfill\begin{minipage}[t]{\fiche@dw}\vspace{0pt}\includegraphics[width=\linewidth,height=.6\textheight,keepaspectratio]{#3}\end{minipage}\fi
  \par\smallskip}

% \ajuste{...} : réduit ce qui dépasse de la ligne
\newsavebox\fiche@aj
\newcommand{\ajuste}[1]{\sbox\fiche@aj{#1}\ifdim\wd\fiche@aj>\linewidth
  \resizebox{\linewidth}{!}{\usebox\fiche@aj}\else\usebox\fiche@aj\fi}

\endinput
